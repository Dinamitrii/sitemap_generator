+# Първи сегмент от пътя, за който почти винаги е добра практика да не се
+# индексира от търсачките (реален SEO консенсус за тези типове страници).
+# Проверяваме за ТОЧНО съвпадение на сегмента, не "startswith" - за да не
+# хванем невинни страници като "/accounting-tips" заради "account".
+SUGGESTED_DISALLOW_SEGMENTS = (
+    'wp-admin', 'wp-login', 'wp-includes', 'wp-json', 'cgi-bin',
+    'admin', 'login', 'signin', 'sign-in', 'register',
+    'account', 'my-account', 'dashboard', 'user',
+    'cart', 'checkout', 'basket',
+    'search', 'private', 'tmp', 'temp', 'feed', 'trackback',
+)
+
+
+def suggest_disallow_paths(urls):
+    """Адаптивно предлага Disallow пътища - само на база РЕАЛНО открити при
+    сканирането страници (не гадаем, не проверяваме нищо, което не е
+    установено чрез самото обхождане).
+    """
+    suggested = set()
+    for url in urls:
+        path = urlparse(url).path.strip('/').lower()
+        if not path:
+            continue
+        first_segment = path.split('/')[0]
+        if first_segment in SUGGESTED_DISALLOW_SEGMENTS:
+            suggested.add(f'/{first_segment}/')
+    return sorted(suggested)
+
