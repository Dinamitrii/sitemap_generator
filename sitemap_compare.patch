+def load_current_sitemap(scheme, netloc, headers, site, robots_raw):
+    """Проверява дали сайтът вече има реален sitemap.xml.
+
+    Първо гледа дали robots.txt сочи явно към sitemap (ред 'Sitemap: ...'),
+    иначе пробва стандартното местоположение /sitemap.xml.
+    Връща (found, raw_text).
+    """
+    candidates = []
+    for line in (robots_raw or '').splitlines():
+        stripped = line.strip()
+        if stripped.lower().startswith('sitemap:'):
+            declared = stripped.split(':', 1)[1].strip()
+            if declared:
+                candidates.append(declared)
+    candidates.append(f'{scheme}://{netloc}/sitemap.xml')
+
+    seen = set()
+    for url in candidates:
+        if url in seen:
+            continue
+        seen.add(url)
+        try:
+            fetched = fetch(url, headers, site)
+        except requests.RequestException:
+            continue
+        if not fetched:
+            continue
+        resp, _ = fetched
+        try:
+            if resp.status_code == 200:
+                raw_text = read_limited(resp).decode('utf-8', 'replace')
+                if raw_text.strip():
+                    return True, raw_text
+        finally:
+            resp.close()
+    return False, ''
+
+
